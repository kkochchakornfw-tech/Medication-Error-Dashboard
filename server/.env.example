# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของโรงพยาบาล
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ชื่อตารางจริงในฐานข้อมูล (แก้ตรงนี้ถ้าชื่อไม่ตรง)
TABLE_MED_ERR=med_err
TABLE_MED_ERR_MEDICINE=med_err_medicine
TABLE_MED_ERR_PROCESS=med_err_process

PORT=4000
